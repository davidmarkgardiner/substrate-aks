# Copy to preflight.env and fill in. Nothing here is a secret. Leave a value empty
# to let the script try to discover it.
SUBSCRIPTION_ID=
RESOURCE_GROUP=          # resource group of the EXISTING cluster
CLUSTER_NAME=
REGISTRY=                # trusted registry host[/path prefix] holding the mirrored images, e.g. registry.corp/mirror
POSTGRES_IMAGE=          # full mirrored ref of postgres:18-alpine, WITH digest: host/path/postgres@sha256:9a8afca5...
PROBE_IMAGE=             # full mirrored ref of python:3.13-alpine, with digest
STORAGE_ACCOUNT=         # account holding the snapshots + assets containers (blank = auto-discover in RESOURCE_GROUP)
NODE_IDENTITY_NAME=      # managed identity federated to ate-system/atelet (blank = discover *-node-store)
CONTROL_IDENTITY_NAME=   # managed identity federated to ate-system/ate-api-server (blank = discover *-control-store)
INSTALL_OBJECT_ID=       # Entra object ID of whoever runs the install (blank = signed-in user)
ASSETS_DIR=              # absolute path: cloud-hypervisor, virtiofsd, vmlinux, rootfs.img
KAGENT_ASSETS_DIR=       # absolute path: kagent-crds-1.0.1.tgz, kagent-1.0.1.tgz, kagent-setup.sql (blank = skip kagent check)
GIT_MIRROR_SUBSTRATE=    # internal URL of the Substrate repo (blank = test the github URL, i.e. the insteadOf rewrite)
GIT_MIRROR_PLUGIN=       # internal URL of the azure-blob plugin repo (same)
WORKER_COUNT=            # expected number of microVM nodes (blank = whatever the cluster has)
